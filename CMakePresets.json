{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "SIGNUM_BUILD_SHADERS": true
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIGNUM_ENABLE_SANITIZERS": false,
        "SIGNUM_ENABLE_REFLECTION": false,
        "SIGNUM_ENABLE_CONTRACTS": false,
        "SIGNUM_BUILD_EDITOR": true,
        "SIGNUM_BUILD_PLAYGROUND": false
      }
    },
    {
      "name": "engine",
      "displayName": "Engine (Debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIGNUM_ENABLE_SANITIZERS": false,
        "SIGNUM_ENABLE_REFLECTION": false,
        "SIGNUM_ENABLE_CONTRACTS": false,
        "SIGNUM_BUILD_EDITOR": false,
        "BUILD_TESTING": true,
        "SIGNUM_BUILD_PLAYGROUND": false
      }
    },
    {
      "name": "playground",
      "displayName": "Playground",
      "inherits": "debug",
      "cacheVariables": {
        "SIGNUM_BUILD_PLAYGROUND": true,
        "SIGNUM_ENABLE_RUNTIME_SHADER_COMPILATION": true,
        "SIGNUM_BUILD_EDITOR": false,
        "BUILD_TESTING": false
      }
    },
    {
      "name": "warnings",
      "displayName": "Debug with warnings as errors",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIGNUM_ENABLE_SANITIZERS": false,
        "SIGNUM_ENABLE_REFLECTION": false,
        "SIGNUM_ENABLE_CONTRACTS": false,
        "SIGNUM_BUILD_EDITOR": true,
        "SIGNUM_BUILD_PLAYGROUND": false,
        "SIGNUM_WARNINGS_AS_ERRORS": true
      }
    },
    {
      "name": "experimental",
      "displayName": "Debug with C++26 experiments",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIGNUM_ENABLE_SANITIZERS": false,
        "SIGNUM_ENABLE_REFLECTION": true,
        "SIGNUM_ENABLE_CONTRACTS": true,
        "SIGNUM_BUILD_EDITOR": false,
        "SIGNUM_BUILD_PLAYGROUND": false
      }
    },
    {
      "name": "asan",
      "displayName": "Debug with sanitizers",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIGNUM_ENABLE_SANITIZERS": true,
        "SIGNUM_BUILD_EDITOR": true,
        "SIGNUM_BUILD_PLAYGROUND": false
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": false,
        "SIGNUM_ENABLE_SANITIZERS": false,
        "SIGNUM_BUILD_EDITOR": false,
        "SIGNUM_BUILD_PLAYGROUND": false
      }
    },
    {
      "name": "bench",
      "displayName": "Optimized Mathematics Benchmarks",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": false,
        "SIGNUM_BUILD_BENCHMARKS": true,
        "SIGNUM_ENABLE_SANITIZERS": false,
        "SIGNUM_ENABLE_REFLECTION": false,
        "SIGNUM_ENABLE_CONTRACTS": false,
        "SIGNUM_BUILD_EDITOR": false,
        "SIGNUM_BUILD_PLAYGROUND": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "engine",
      "configurePreset": "engine"
    },
    {
      "name": "playground",
      "configurePreset": "playground"
    },
    {
      "name": "warnings",
      "configurePreset": "warnings"
    },
    {
      "name": "experimental",
      "configurePreset": "experimental"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "bench",
      "configurePreset": "bench"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "engine",
      "configurePreset": "engine",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "warnings",
      "configurePreset": "warnings",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "experimental",
      "configurePreset": "experimental",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
