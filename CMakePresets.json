{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": false,
        "SIGNUM_BUILD_SHADERS": false,
        "SIGNUM_BUILD_EDITOR": false,
        "SIGNUM_BUILD_PLAYGROUND": false,
        "SIGNUM_BUILD_BENCHMARKS": false,
        "SIGNUM_ENABLE_RUNTIME_SHADER_COMPILATION": false,
        "SIGNUM_ENABLE_SANITIZERS": false,
        "SIGNUM_ENABLE_REFLECTION": false,
        "SIGNUM_ENABLE_CONTRACTS": false,
        "SIGNUM_WARNINGS_AS_ERRORS": false
      }
    },
    {
      "name": "debug",
      "displayName": "Full Development Workspace",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": true,
        "SIGNUM_BUILD_SHADERS": true,
        "SIGNUM_BUILD_EDITOR": true,
        "SIGNUM_ENABLE_RUNTIME_SHADER_COMPILATION": true
      }
    },
    {
      "name": "editor",
      "displayName": "Editor Development",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIGNUM_BUILD_EDITOR": true,
        "SIGNUM_ENABLE_RUNTIME_SHADER_COMPILATION": true
      }
    },
    {
      "name": "engine",
      "displayName": "Engine Development and Tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": true,
        "SIGNUM_BUILD_SHADERS": true
      }
    },
    {
      "name": "playground",
      "displayName": "Playground Development",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIGNUM_BUILD_PLAYGROUND": true,
        "SIGNUM_BUILD_SHADERS": true,
        "SIGNUM_ENABLE_RUNTIME_SHADER_COMPILATION": true
      }
    },
    {
      "name": "warnings",
      "displayName": "Warnings as Errors",
      "inherits": "debug",
      "cacheVariables": {
        "SIGNUM_WARNINGS_AS_ERRORS": true
      }
    },
    {
      "name": "experimental",
      "displayName": "Experimental C++26",
      "inherits": "engine",
      "cacheVariables": {
        "SIGNUM_ENABLE_REFLECTION": true,
        "SIGNUM_ENABLE_CONTRACTS": true
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer and UBSan",
      "inherits": "debug",
      "cacheVariables": {
        "SIGNUM_ENABLE_SANITIZERS": true
      }
    },
    {
      "name": "release",
      "displayName": "Production Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "bench",
      "displayName": "Optimized Benchmarks",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SIGNUM_BUILD_BENCHMARKS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "editor",
      "configurePreset": "editor"
    },
    {
      "name": "engine",
      "configurePreset": "engine"
    },
    {
      "name": "playground",
      "configurePreset": "playground"
    },
    {
      "name": "warnings",
      "configurePreset": "warnings"
    },
    {
      "name": "experimental",
      "configurePreset": "experimental"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "bench",
      "configurePreset": "bench"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "engine",
      "configurePreset": "engine",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "warnings",
      "configurePreset": "warnings",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "experimental",
      "configurePreset": "experimental",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
